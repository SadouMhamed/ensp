# ── Database (Neon) ─────────────────────────────────────────────
# Filled automatically by `neon deploy` / `neon env pull`.
# Pooled (-pooler host): used by the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"
# Direct (no -pooler): used by drizzle-kit migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── Auth (Better Auth) ──────────────────────────────────────────
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"

# ── First admin account (used by `npm run db:seed`) ─────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_NAME="Admin"

# ── Media storage (Neon Object Storage — S3 compatible) ──────────
# Bucket "site-media" is declared in neon.ts. `neon deploy` (or `neon env pull`)
# fills these in automatically — don't type them by hand.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
# Optional: bucket name (default "site-media")
# MEDIA_BUCKET="site-media"

# ── Search engines ───────────────────────────────────────────────
# Leave unset on the test site (Google is asked not to list it).
# Real launch: set to true on the host, then redeploy.
# ALLOW_INDEXING=true

# Email (nodemailer, SMTP) — used for "Mot de passe oublié" emails.
# Port 465 = SSL, 587 = STARTTLS. Without these, in development the email is
# printed in the server log instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="ENSP <no-reply@example.com>"
