# ── Database (Neon) ─────────────────────────────────────────────
# Filled automatically by `neon deploy` / `neon env pull`.
# Pooled (-pooler host): used by the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"
# Direct (no -pooler): used by drizzle-kit migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── Auth (Better Auth) ──────────────────────────────────────────
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── First admin account (used by `npm run db:seed`) ─────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_NAME="Admin"

# ── Media storage (Cloudflare R2 — S3 compatible) ───────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public URL of the bucket (r2.dev URL or your custom domain)
R2_PUBLIC_URL=""
